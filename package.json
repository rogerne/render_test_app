{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "node --experimental-wasm-modules node_modules/esbuild-wasm/bin/esbuild app/javascript/application.js --bundle --outdir=app/assets/builds --public-path=/assets",
    "sass": "sass",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss ./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "postcss": "postcss",
    "build:css:prefix": "yarn postcss ./app/assets/builds/application.css --use autoprefixer --output ./app/assets/builds/application.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "sass-embedded": "^1.104.0"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/stimulus-webpack-helpers": "^1.0.1",
    "@hotwired/turbo-rails": "^8.0.23",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  }
}
